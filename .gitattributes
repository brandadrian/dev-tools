# Auto detect text files and normalize line endings to LF
* text=auto

# C# files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# Configuration files
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Batch files and scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.class binary
*.jar binary
*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.psd binary
*.zip binary
